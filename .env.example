# Copy to .env and fill in. Never commit .env (spec section 50).

# --- Microsoft Entra ID app registration (app-only / client credentials) ---
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# --- SharePoint site + document library ---
SHAREPOINT_HOST=auximotechgmbh.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/AuximoKnowledgeHub
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# --- Database ---
# Under docker compose the app service overrides the host to "db".
DATABASE_URL=postgresql+asyncpg://knowledge_agent:knowledge_agent@localhost:5432/knowledge_agent
# Used by docker compose for the db container (change it for anything shared).
POSTGRES_PASSWORD=knowledge_agent

# --- API security ---
# Required header on every endpoint except /health: "X-API-Key: <value>"
# (or "Authorization: Bearer <value>"). Leave empty only on a trusted machine.
API_KEY=
# /debug/* and /discovery/preview (raw Graph errors, document content).
ENABLE_DEBUG_ENDPOINTS=false

# --- Chat API (POST /chat, used by the SharePoint chat bubble) ---
# Entra audience user tokens must be issued for: api://<CLIENT_ID> (the app
# registration's "Expose an API" URI). Empty = dev mode: /chat uses API_KEY
# and all callers share one identity. Always set this in production.
CHAT_AUTH_AUDIENCE=
CHAT_REQUIRED_SCOPE=user_impersonation
# Optional: only users with this Entra app role may chat (e.g. KnowledgeHub.Chat).
# Empty = every user of the tenant, which is the intended setting.
CHAT_REQUIRED_ROLE=
# Exact browser origins allowed to call the API (comma-separated, no "*").
CORS_ALLOWED_ORIGINS=https://auximotechgmbh.sharepoint.com
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_HISTORY_TURNS=6
CHAT_WARMUP_MODELS=true

# --- Scheduler (daily sync, weekly reconciliation) ---
SYNC_SCHEDULE_ENABLED=true
SYNC_SCHEDULE_TIME=02:00
# IANA timezone, e.g. Europe/Berlin. Empty = server local time.
SYNC_SCHEDULE_TIMEZONE=
RECONCILIATION_INTERVAL_DAYS=7
SYNC_PAGES_ON_SCHEDULE=true

# --- Embeddings ---
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBED_AFTER_SYNC=true

# --- Reranking (search + ask) ---
RERANK_ENABLED=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=30
# Minimum 0..1 relevance for chunks sent to the LLM; unset = no cut-off.
# RERANK_MIN_RELEVANCE=0.001

# --- LLM answers (CLI "ask") ---
AZURE_OPENAI_ENDPOINT=https://auximoplayground-llm.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Logging ---
LOG_LEVEL=INFO
# text (key=value) or json (one object per line, for log shippers)
LOG_FORMAT=text

# --- HTTP / retry tuning ---
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE_SECONDS=1
HTTP_MAX_BACKOFF_SECONDS=120
MAX_CONCURRENT_GRAPH_REQUESTS=4
